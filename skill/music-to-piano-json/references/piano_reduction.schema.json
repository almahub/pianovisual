{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/piano_reduction_v2.json",
  "type": "object",
  "required": ["format", "title", "artist", "source", "musicalInfo", "arrangementMode", "sections", "chords", "tracks"],
  "properties": {
    "format": {"const": "piano_reduction_v2"},
    "arrangementMode": {"enum": ["piano_voice", "piano_solo"]},
    "title": {"type": "string"}, "artist": {"type": "string"},
    "source": {"type": "object", "required": ["filename", "type", "analysis_mode", "confidence"], "properties": {
      "filename": {"type": "string"}, "type": {"enum": ["json", "midi", "musicxml"]},
      "analysis_mode": {"const": "structured"}, "confidence": {"$ref": "#/$defs/confidence"}
    }, "additionalProperties": true},
    "musicalInfo": {"type": "object", "required": ["duration", "meter", "tempo", "tempoMap", "timeSignatureMap", "keySignatureMap"], "properties": {
      "duration": {"type": "number", "minimum": 0}, "ppq": {"type": ["integer", "null"]}, "key": {"type": ["string", "null"]},
      "meter": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}], "minItems": 2, "maxItems": 2},
      "tempo": {"type": "number", "exclusiveMinimum": 0}, "tempoMap": {"type": "array"},
      "timeSignatureMap": {"type": "array"}, "keySignatureMap": {"type": "array"}
    }, "additionalProperties": true},
    "sections": {"type": "array", "items": {"$ref": "#/$defs/section"}},
    "chords": {"type": "array", "items": {"$ref": "#/$defs/chord"}},
    "tracks": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/track"}}
  },
  "$defs": {
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "note": {"type": "object", "required": ["midi", "name", "time", "duration", "velocity", "confidence"], "properties": {
      "midi": {"type": "integer", "minimum": 0, "maximum": 127}, "name": {"type": "string"},
      "time": {"type": "number", "minimum": 0}, "duration": {"type": "number", "exclusiveMinimum": 0},
      "velocity": {"type": "number", "minimum": 0, "maximum": 1}, "measure": {"type": "integer", "minimum": 1},
      "beat": {"type": "number", "minimum": 1}, "confidence": {"$ref": "#/$defs/confidence"}
    }, "additionalProperties": true},
    "track": {"type": "object", "required": ["id", "name", "role", "hand", "instrument", "confidence", "notes"], "properties": {
      "id": {"type": "string"}, "name": {"type": "string"}, "role": {"enum": ["melody", "harmony", "bass"]},
      "hand": {"enum": ["right", "left", "none"]}, "instrument": {"enum": ["piano", "voice"]}, "confidence": {"$ref": "#/$defs/confidence"},
      "notes": {"type": "array", "items": {"$ref": "#/$defs/note"}}
    }, "additionalProperties": true},
    "chord": {"type": "object", "required": ["time", "duration", "symbol", "root", "quality", "bass", "bassPitchClass", "pitchClasses", "confidence"], "properties": {
      "time": {"type": "number", "minimum": 0}, "duration": {"type": "number", "exclusiveMinimum": 0},
      "measure": {"type": "integer", "minimum": 1}, "beat": {"type": "number", "minimum": 1},
      "symbol": {"type": "string"}, "root": {"type": "integer", "minimum": 0, "maximum": 11},
      "quality": {"type": "string"}, "bass": {"type": "string"}, "bassPitchClass": {"type": "integer", "minimum": 0, "maximum": 11}, "pitchClasses": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 11}, "uniqueItems": true},
      "confidence": {"$ref": "#/$defs/confidence"}
    }, "additionalProperties": true},
    "section": {"type": "object", "required": ["id", "type", "start", "end", "confidence"], "properties": {
      "id": {"type": "string"}, "type": {"enum": ["intro", "verse", "pre_chorus", "chorus", "bridge", "instrumental", "outro", "section"]},
      "family": {"type": "string"}, "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "minimum": 0},
      "confidence": {"$ref": "#/$defs/confidence"}
    }, "additionalProperties": true}
  },
  "additionalProperties": false
}
